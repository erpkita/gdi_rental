<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
    
        <record id="gdi_rq_sequence" model="ir.sequence">
            <field name="name">GDI RQ Sequence</field>
            <field name="code">rental.quotation</field>
            <field name="prefix">%(y)s%(month)s</field>
            <field name="padding">4</field>
        </record>

        <record id="gdi_rental_contract_sequence" model="ir.sequence">
            <field name="name">GDI Rental Contract</field>
            <field name="code">rental.contract.seq</field>
            <field name="prefix">%(y)s%(month)s</field>
            <field name="padding">4</field>
        </record>

        <record id="gdi_rental_delivery_order_sequence" model="ir.sequence">
            <field name="name">GDI RDO Sequence</field>
            <field name="code">gdi.rental.delivery.order.seq</field>
            <field name="prefix">RDO%(y)s%(month)s</field>
            <field name="padding">4</field>
        </record>

        <record id="gdi_rental_quotation_new_sequence" model="ir.sequence">
            <field name="name">GDI Rental Quotation</field>
            <field name="code">gdi.rental.quotation</field>
            <field name="prefix">RQ%(y)s%(month)s</field>
            <field name="padding">4</field>
        </record>

        <record id="gdi_rental_order_sequence" model="ir.sequence">
            <field name="name">GDI Rental Order</field>
            <field name="code">gdi.rental.order</field>
            <field name="prefix">%(y)s%(month)s</field>
            <field name="padding">4</field>
        </record>

        <record id="gdi_rental_component_replacement_sequence" model="ir.sequence">
            <field name="name">Rental Component Replacement</field>
            <field name="code">rental.component.replacement.seq</field>
            <field name="prefix">RPL%(y)s%(month)s</field>
            <field name="padding">4</field>
        </record>

    </data>

</odoo>
