<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Wizard Form View -->
    <record id="view_rental_component_replacement_wizard_form" model="ir.ui.view">
        <field name="name">rental.component.replacement.wizard.form</field>
        <field name="model">rental.component.replacement.wizard</field>
        <field name="arch" type="xml">
            <form string="Replace Component">
                <group string="Current Component">
                    <group>
                        <field name="component_id" readonly="1"/>
                        <field name="product_id" readonly="1"/>
                        <field name="current_lot_id" readonly="1"/>
                    </group>
                    <group>
                        <field name="order_line_id" readonly="1"/>
                    </group>
                </group>

                <separator string="Replacement Details"/>
                <group>
                    <group string="New Item">
                        <field name="new_product_id"/>
                        <field name="new_lot_id"/>
                        <field name="new_src_location_id"/>
                    </group>
                    <group string="Old Item Destination">
                        <field name="old_item_destination" widget="radio"/>
                        <field name="dest_location_id"/>
                    </group>
                </group>

                <separator string="Reason"/>
                <group>
                    <field name="reason"/>
                    <field name="notes" placeholder="Explain why this component is being replaced..."/>
                </group>

                <div class="alert alert-warning" role="alert">
                    <strong>Note:</strong> This action will:
                    <ul class="mb-0">
                        <li>Return the old item (with its current serial/lot) to the selected destination</li>
                        <li>Deliver the new item (with the selected serial/lot) to the customer</li>
                        <li>Both stock transfers will be auto-validated</li>
                    </ul>
                </div>

                <footer>
                    <button string="Confirm Replacement" type="object"
                            name="action_confirm" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_rental_component_replacement_wizard" model="ir.actions.act_window">
        <field name="name">Replace Component</field>
        <field name="res_model">rental.component.replacement.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Replacement Log Form View -->
    <record id="view_rental_component_replacement_form" model="ir.ui.view">
        <field name="name">rental.component.replacement.form</field>
        <field name="model">rental.component.replacement</field>
        <field name="arch" type="xml">
            <form string="Component Replacement">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Replacement Info">
                            <field name="order_id"/>
                            <field name="order_line_id"/>
                            <field name="product_id"/>
                            <field name="reason"/>
                            <field name="date"/>
                            <field name="user_id"/>
                        </group>
                        <group string="Serial/Lot Tracking">
                            <field name="old_component_id"/>
                            <field name="old_lot_id"/>
                            <field name="new_component_id"/>
                            <field name="new_lot_id"/>
                        </group>
                    </group>
                    <group>
                        <group string="Stock Transfers">
                            <field name="return_picking_id"/>
                            <field name="delivery_picking_id"/>
                        </group>
                        <group string="Old Item Destination">
                            <field name="old_item_destination"/>
                            <field name="dest_location_id"/>
                            <field name="src_location_id"/>
                        </group>
                    </group>
                    <group string="Notes" attrs="{'invisible': [('notes', '=', False)]}">
                        <field name="notes" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Replacement Log Tree View -->
    <record id="view_rental_component_replacement_tree" model="ir.ui.view">
        <field name="name">rental.component.replacement.tree</field>
        <field name="model">rental.component.replacement</field>
        <field name="arch" type="xml">
            <tree string="Component Replacements">
                <field name="name"/>
                <field name="date"/>
                <field name="product_id"/>
                <field name="old_lot_id"/>
                <field name="new_lot_id"/>
                <field name="reason"/>
                <field name="old_item_destination"/>
                <field name="user_id"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-muted="state == 'cancel'"
                       decoration-info="state == 'draft'"/>
            </tree>
        </field>
    </record>

</odoo>
