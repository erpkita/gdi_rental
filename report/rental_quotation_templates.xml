<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="gdi_rental_quotation_document">
        <t t-call="web.external_layout">
            <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)" />
            <t t-set="forced_vat" t-value="doc.fiscal_position_id.foreign_vat"/>
            <t t-set="colclass" t-value="('col-sm-5' if report_type == 'html' else 'col-5') + ' ml-auto'"/>
            <div class="row">
                <div class="col-7">
                    <strong>Customer:</strong>
                    <div style="font-size:13px;" t-field="doc.partner_id" t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>
                    <div class="pt-2" style="font-size:13px;">
                        <div>Tel &#160;&#160;&#160;&#160;:
                            <t t-if="doc.partner_id.phone">
                                <span t-field="doc.partner_id.phone"/>
                            </t>
                        </div>
                        <div>Email &#160;:
                            <t t-if="doc.partner_id.email">
                                <span t-field="doc.partner_id.email"/>
                            </t>
                        </div>
                        <div>Attn &#160;:
                            <t t-if="doc.partner_shipping_id">
                                <span t-field="doc.partner_shipping_id.name"/>
                            </t>
                            <t t-else="">
                                <span t-field="doc.partner_id.name"/>
                            </t>
                        </div>
                    </div>
                </div>
                <div class="col-5">
                    <strong>Shipping Address:</strong>
                    <t t-if="doc.partner_shipping_id">
                        <div style="font-size:13px;" t-field="doc.partner_shipping_id" t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>
                    </t>
                </div>
            </div>
            <div class="page" style="font-size:14px;">
                <div class="oe_structure mt-10"/>
                <div class="pt-2"></div>
                <h4 class="mt16" style="font-weight:bold;">
                    <span>Quotation No </span>
                    <span t-field="doc.name"/>
                </h4>
                <div class="row mt32 mb32" id="informations">
                    <div t-if="doc.date_order" class="col-auto col-3 mw-100 mb-2">
                        <strong>Quotation Date:</strong>
                        <p class="m-0" t-field="doc.date_order" t-options='{"widget": "date"}'/>
                    </div>
                    <div t-if="doc.customer_reference" class="col-auto col-3 mw-100 mb-2">
                        <strong>Customer Ref No.:</strong>
                        <p class="m-0" t-field="doc.customer_reference"/>
                    </div>
                    <div t-if="doc.validity_date" class="col-auto col-3 mw-100 mb-2" name="expiration_date">
                        <strong>Validity Date:</strong>
                        <p class="m-0" t-field="doc.validity_date"/>
                    </div>
                    <div t-if="doc.customer_po_number" class="col-auto col-3 mw-100 mb-2">
                        <strong>Customer PO No.:</strong>
                        <p class="m-0" t-field="doc.customer_po_number"/>
                    </div>
                </div>

                <!-- Rental Period -->
                <div class="row mb32" t-if="doc.rental_start_date or doc.rental_end_date">
                    <div t-if="doc.rental_start_date" class="col-auto col-3 mw-100 mb-2">
                        <strong>Rental Start Date:</strong>
                        <p class="m-0" t-field="doc.rental_start_date"/>
                    </div>
                    <div t-if="doc.rental_end_date" class="col-auto col-3 mw-100 mb-2">
                        <strong>Rental End Date:</strong>
                        <p class="m-0" t-field="doc.rental_end_date"/>
                    </div>
                    <div t-if="doc.rental_duration" class="col-auto col-3 mw-100 mb-2">
                        <strong>Duration:</strong>
                        <p class="m-0">
                            <span t-field="doc.rental_duration"/> Month(s)
                        </p>
                    </div>
                </div>

                <div class="row">
                    <div class="col-12">
                        <p>Refer to your reference above, we are pleased to quote you as follows :</p>
                    </div>
                </div>

                <!-- Is there a discount on at least one line? -->
                <t t-set="display_discount" t-value="any(l.discount for l in doc.order_line)"/>
                <div class="pt-2"></div>
                <table class="table table-sm o_main_table" style="font-size:14px;">
                    <thead style="display: table-row-group">
                        <tr>
                            <th name="th_no" class="text-left" style="width:5%;">No</th>
                            <th name="th_item_code" class="text-left" style="width:15%;">Item Code</th>
                            <th name="th_description" class="text-left">Description</th>
                            <th name="th_quantity" class="text-right" style="width:10%;">Quantity</th>
                            <th name="th_priceunit" class="text-right" style="width:12%;">Unit Price</th>
                            <th name="th_discount" t-if="display_discount" class="text-right" style="width:8%;"
                                groups="product.group_discount_per_so_line">
                                <span>Disc.%</span>
                            </th>
                            <th name="th_subtotal" class="text-right" style="width:15%;">
                                <span groups="account.group_show_line_subtotals_tax_excluded">Amount</span>
                                <span groups="account.group_show_line_subtotals_tax_included">Total Price</span>
                            </th>
                        </tr>
                    </thead>
                    <tbody class="sale_tbody">

                        <t t-set="current_subtotal" t-value="0"/>
                        <t t-set="no_seq" t-value="0"/>

                        <t t-foreach="doc.order_line" t-as="line">

                            <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>
                            <t t-set="current_subtotal" t-value="current_subtotal + line.price_total" groups="account.group_show_line_subtotals_tax_included"/>
                            <t t-set="no_seq" t-value="no_seq + 1"/>

                            <tr>
                                <td name="td_no"><span t-esc="no_seq"/></td>

                                <!-- Item Code -->
                                <td name="td_item_code">
                                    <t t-if="line.line_type == 'unit'">
                                        <t t-if="line.product_id.item_code_ref">
                                            <span t-field="line.product_id.item_code_ref"/>
                                        </t>
                                        <t t-elif="line.item_code">
                                            <span t-field="line.item_code"/>
                                        </t>
                                        <t t-else="">-</t>
                                    </t>
                                    <t t-else="">
                                        <span t-field="line.item_code"/>
                                    </t>
                                </td>

                                <!-- Description -->
                                <td name="td_name"><span t-field="line.name"/></td>

                                <!-- Quantity -->
                                <td name="td_quantity" class="text-right">
                                    <span t-field="line.product_uom_qty"/>
                                    <span t-field="line.product_uom_txt"/>
                                </td>

                                <!-- Unit Price -->
                                <td name="td_priceunit" class="text-right">
                                    <span t-field="line.price_unit"/>
                                </td>

                                <!-- Discount -->
                                <td name="td_discount" class="text-right" t-if="display_discount"
                                    groups="product.group_discount_per_so_line">
                                    <span t-field="line.discount"/>
                                </td>

                                <!-- Subtotal / Total -->
                                <td name="td_subtotal" class="text-right o_price_total">
                                    <span t-field="line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>
                                    <span t-field="line.price_total" groups="account.group_show_line_subtotals_tax_included"/>
                                </td>
                            </tr>

                        </t>
                    </tbody>
                </table>

                <!-- Totals -->
                <div class="clearfix" name="so_total_summary">
                    <div id="total" class="row" name="total">
                        <div class="col-6 ml-auto">
                            <table class="table table-sm">
                                <tr class="border-black" groups="account.group_show_line_subtotals_tax_excluded">
                                    <td><strong>Subtotal</strong></td>
                                    <td class="text-right">
                                        <span t-field="doc.amount_untaxed"
                                              t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                    </td>
                                </tr>
                                <t t-if="doc.amount_tax">
                                    <tr>
                                        <td>Taxes</td>
                                        <td class="text-right">
                                            <span t-field="doc.amount_tax"
                                                  t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                        </td>
                                    </tr>
                                </t>
                                <tr class="border-black o_total">
                                    <td><strong>Total</strong></td>
                                    <td class="text-right">
                                        <span t-field="doc.amount_total"
                                              t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="oe_structure"/>

                <!-- Notes -->
                <t t-if="doc.note">
                    <div class="row mt16">
                        <div class="col-12">
                            <strong>Notes:</strong>
                        </div>
                        <div class="col-12">
                            <span t-field="doc.note"/>
                        </div>
                    </div>
                </t>

                <!-- Signature -->
                <div class="row mt32 signature">
                    <div class="col-6">
                        <table width="100%">
                            <tr>
                                <td style="text-align:center;"><strong>Your Faithfully</strong></td>
                            </tr>
                            <tr style="height:80px;">
                                <td style="text-align:center;"></td>
                            </tr>
                            <tr>
                                <td style="text-align:center;">
                                    <span t-field="doc.user_id.name"/>
                                </td>
                            </tr>
                        </table>
                    </div>
                    <div class="col-6">
                        <table width="100%">
                            <tr>
                                <td style="text-align:center;"><strong>Customer Confirmation</strong></td>
                            </tr>
                            <tr style="height:80px;">
                                <td style="text-align:center;"></td>
                            </tr>
                            <tr>
                                <td style="text-align:center;">
                                    <span t-field="doc.partner_id.name"/><br/>
                                    <span><u>Signature, Date &amp; Stamp</u></span>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>
        </t>
    </template>


    <template id="report_rental_quotation">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="gdi_rental.gdi_rental_quotation_document" t-lang="doc.partner_id.lang"/>
            </t>
        </t>
    </template>

</odoo>
