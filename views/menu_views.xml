<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Dashboard Client Action -->
    <record id="action_rental_dashboard" model="ir.actions.client">
        <field name="name">Rental Dashboard</field>
        <field name="tag">gdi_rental.dashboard</field>
    </record>

    <menuitem id="menu_gdi_rental_root" name="GDI Rental" sequence="8">

        <menuitem
            id="menu_rental_dashboard"
            name="Dashboard"
            action="action_rental_dashboard"
            sequence="1"/>

        <menuitem
            id="menu_gdi_rental_main"
            name="Rental"
            sequence="10">

            <menuitem
                id="menu_gdi_rental_quotation_new"
                name="Quotations"
                action="gdi_rental.action_gdi_rental_quotation"
                sequence="1"/>

            <menuitem
                id="menu_gdi_rental_order"
                name="Rental Orders"
                action="action_gdi_rental_order"
                sequence="2"/>

            <menuitem
                id="menu_gdi_rental_contract"
                name="Contracts"
                action="action_gdi_rental_contracts_view"
                sequence="3"/>

        </menuitem>

        <menuitem 
            id="menu_gdi_rental_delivery_order"
            name="RDO"
            action="action_gdi_rental_view"
            sequence="35"
        />

        <menuitem 
            id="gdi_menu_rental_equipment"
            name="Rental Equipment"
            sequence="40">

            <!-- <menuitem 
                id="gdi_menu_rental_products" 
                name="Products" 
                sequence="1" 
                action="gdi_rental.gdi_rental_product_template_action" /> -->

            <menuitem 
                id="gdi_menu_rental_products_variant" 
                name="Rental Items" 
                sequence="2" 
                action="gdi_rental.gdi_rental_product_product_action" />

            <menuitem id="menu_gdi_rental_set"
                      name="Rental Sets"
                      action="action_gdi_rental_set"
                      sequence="3"/>

        </menuitem>

    </menuitem>

    <menuitem id="menu_gdi_rental_config"
              name="Configuration"
              parent="menu_gdi_rental_root"
              sequence="100"/>



</odoo>
