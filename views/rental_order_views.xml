<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================== -->
    <!-- GDI RENTAL ORDER: TREE VIEW                                        -->
    <!-- ================================================================== -->

    <record id="view_gdi_rental_order_tree" model="ir.ui.view">
        <field name="name">view.gdi.rental.order.tree</field>
        <field name="model">gdi.rental.order</field>
        <field name="arch" type="xml">
            <tree decoration-muted="state in ['hireoff']"
                  decoration-info="state in ['confirm']"
                  decoration-danger="state == 'cancel'"
                  decoration-success="state == 'ongoing'">
                <field name="name"/>
                <field name="date_order"/>
                <field name="partner_id"/>
                <field name="user_id" optional="show"/>
                <field name="customer_reference" optional="show"/>
                <field name="customer_po_number" optional="hide"/>
                <field name="amount_total" sum="Total" widget="monetary"/>
                <field name="currency_id" invisible="1"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <!-- ================================================================== -->
    <!-- GDI RENTAL ORDER: FORM VIEW                                        -->
    <!-- ================================================================== -->

    <record id="view_gdi_rental_order_form" model="ir.ui.view">
        <field name="name">view.gdi.rental.order.form</field>
        <field name="model">gdi.rental.order</field>
        <field name="arch" type="xml">
            <form string="Rental Order" class="o_sale_order">
                <field name="id" invisible="1"/>
                <field name="contract_id" invisible="1"/>

                <!-- ====== HEADER BUTTONS & STATUSBAR ====== -->
                <header>
                    <button name="action_start_rental" type="object"
                            string="Start Rental" states="confirm"
                            class="btn-primary"
                            confirm="Are you sure? Please double-check the rental period, customer details, and terms before proceeding."/>
                    <button name="action_create_contract" type="object"
                            string="Extend &amp; Create New Contract"
                            states="ongoing" class="btn-success"/>
                    <button name="action_print_order"
                            states="confirm,ongoing"
                            string="Print RO" type="object"/>
                    <button name="action_hireoff" states="ongoing"
                            string="Hire off" type="object"
                            class="btn-danger"
                            confirm="Are you sure you want to hire-off this rental order? This will return all active rental items to inventory."/>
                    <button name="action_cancel" states="confirm"
                            string="Cancel" type="object"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="confirm,ongoing,hireoff"/>
                </header>

                <sheet>
                    <!-- ====== TITLE AREA ====== -->
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <!-- ====== MAIN HEADER: CUSTOMER + ORDER INFO ====== -->
                    <group name="ro_header">
                        <!-- LEFT: Customer Details -->
                        <group name="partner_details">
                            <field name="partner_id"
                                   attrs="{'readonly': [('state', 'in', ['ongoing', 'hireoff', 'cancel'])]}"
                                   widget="res_partner_many2one"
                                   context="{'res_partner_search_mode': 'customer',
                                             'show_address': 1, 'show_vat': True}"
                                   options='{"always_reload": True}'/>
                            <field name="partner_invoice_id" string="Invoice Address"
                                   attrs="{'readonly': [('state', 'in', ['ongoing', 'hireoff', 'cancel'])]}"
                                   context="{'default_type':'invoice'}"
                                   options='{"always_reload": True}'
                                   domain="['|', ('parent_id', '=', partner_id), ('id', '=', partner_id)]"/>
                            <field name="partner_shipping_id" string="Delivery Address"
                                   attrs="{'readonly': [('state', 'in', ['ongoing', 'hireoff', 'cancel'])]}"
                                   context="{'default_type':'delivery'}"
                                   options='{"always_reload": True}'
                                   domain="['|', ('parent_id', '=', partner_id), ('id', '=', partner_id)]"/>
                        </group>

                        <!-- RIGHT: Order Details -->
                        <group name="order_details">
                            <field name="date_order"
                                   attrs="{'readonly': [('state', 'in', ['ongoing', 'hireoff', 'cancel'])]}"/>
                            <field name="customer_reference"
                                   attrs="{'readonly': [('state', 'in', ['ongoing', 'hireoff', 'cancel'])]}"/>
                            <field name="customer_po_number"
                                   attrs="{'readonly': [('state', 'in', ['ongoing', 'hireoff', 'cancel'])]}"/>
                            <field name="user_id" widget="many2one_avatar_user"
                                   attrs="{'readonly': [('state', 'in', ['ongoing', 'hireoff', 'cancel'])]}"/>
                        </group>
                    </group>

                    <!-- ====== RENTAL SCHEDULE SECTION ====== -->
                    <group name="rental_schedule" string="Rental Schedule">
                        <group string="Period">
                            <label for="start_date" string="Rental Period"/>
                            <div class="o_row">
                                <field name="start_date" class="oe_inline"
                                       attrs="{'readonly': [('state', 'in', ['cancel', 'ongoing', 'hireoff'])]}"/>
                                <i class="fa fa-long-arrow-right mx-2"
                                   aria-label="Arrow" title="Arrow"/>
                                <field name="end_date" class="oe_inline"
                                       attrs="{'readonly': [('state', 'in', ['cancel', 'ongoing', 'hireoff'])]}"/>
                            </div>
                            <field name="rental_duration" string="Duration (Months)"
                                   readonly="1"/>
                        </group>
                        <group string="Status">
                            <field name="effective_end_date" string="Effective End Date"
                                   readonly="1"
                                   attrs="{'invisible': [('contract_id', '=', False)]}"/>
                            <field name="duration" invisible="1"/>
                            <field name="duration_unit" invisible="1"/>
                        </group>
                    </group>

                    <!-- ====== MAIN NOTEBOOK ====== -->
                    <notebook>

                        <!-- ====== TAB 1: ORDER LINES ====== -->
                        <page string="Order Lines" name="order_lines">
                            <field name="order_line"
                                   context="{'default_order_id': id}"
                                   attrs="{'readonly': [('state', 'in', ('ongoing', 'hireoff', 'cancel'))]}">

                                <!-- LINE TREE (non-editable: click to open popup) -->
                                <tree string="Rental Order Lines"
                                      decoration-muted="rental_state == 'hireoff'"
                                      decoration-success="rental_state == 'active'">
                                    <field name="sequence" widget="handle"/>
                                    <field name="item_type" string="Type"/>
                                    <field name="item_code"/>
                                    <field name="name" string="Description"/>
                                    <field name="duration_string" string="Duration"/>
                                    <field name="start_date" string="From" optional="show"/>
                                    <field name="end_date" string="To" optional="show"/>
                                    <field name="product_uom_qty" string="Qty" force_save="1"/>
                                    <field name="product_uom" string="UoM"
                                           groups="uom.group_uom" optional="show"/>
                                    <field name="price_unit"/>
                                    <field name="discount" string="Disc.%"
                                           groups="product.group_discount_per_so_line"
                                           optional="hide"/>
                                    <field name="tax_id" widget="many2many_tags"
                                           optional="hide"
                                           domain="[('type_tax_use','=','sale'),('company_id','=',parent.company_id)]"
                                           options="{'no_create': True}"/>
                                    <field name="price_subtotal" widget="monetary"
                                           groups="account.group_show_line_subtotals_tax_excluded"
                                           sum="Total"/>
                                    <field name="price_total" widget="monetary"
                                           groups="account.group_show_line_subtotals_tax_included"
                                           sum="Total"/>
                                    <field name="rental_state" string="Status"
                                           widget="badge"
                                           decoration-success="rental_state == 'active'"
                                           decoration-muted="rental_state == 'hireoff'"
                                           decoration-info="rental_state == 'draft'"/>
                                    <field name="currency_id" invisible="1"/>
                                    <field name="company_id" invisible="1"/>
                                    <field name="state" invisible="1"/>
                                    <button name="action_item_hireoff" type="object"
                                            string="Hire-Off" class="btn-secondary"
                                            attrs="{'invisible': ['|', ('parent.state', '!=', 'ongoing'), ('rental_state', '!=', 'active')]}"/>
                                </tree>

                                <!-- LINE POPUP FORM -->
                                <form string="Rental Order Line Detail">
                                    <header>
                                        <field name="rental_state" widget="statusbar"
                                               statusbar_visible="draft,active,hireoff"/>
                                    </header>
                                    <sheet>
                                        <!-- == SECTION 1: ITEM DEFINITION == -->
                                        <group name="item_definition">
                                            <group string="Item Type">
                                                <field name="item_type"
                                                       widget="radio"
                                                       options="{'horizontal': true}"/>

                                                <!-- Unit: Product Selection -->
                                                <field name="product_id"
                                                       attrs="{'invisible': [('item_type', '=', 'set')],
                                                               'required': [('item_type', '=', 'unit')]}"
                                                       domain="[('rent_ok', '=', True),
                                                                '|', ('company_id', '=', False),
                                                                ('company_id', '=', parent.company_id)]"
                                                       context="{'partner_id': parent.partner_id}"
                                                       force_save="1"
                                                       options="{'no_create': True, 'no_open': True}"/>

                                                <field name="item_code"/>
                                            </group>

                                            <group string="Description">
                                                <field name="name" nolabel="1"
                                                       placeholder="Product description..."
                                                       colspan="2"/>
                                            </group>
                                        </group>

                                        <separator/>

                                        <!-- == SECTION 2: RENTAL PERIOD == -->
                                        <group name="period_section" string="Rental Period">
                                            <group>
                                                <label for="start_date" string="Period"/>
                                                <div class="o_row">
                                                    <field name="start_date"
                                                           widget="daterange"
                                                           options="{'related_end_date': 'end_date'}"
                                                           class="oe_inline"/>
                                                    <i class="fa fa-long-arrow-right mx-2"
                                                       aria-label="Arrow" title="Arrow"/>
                                                    <field name="end_date"
                                                           widget="daterange"
                                                           options="{'related_start_date': 'start_date'}"
                                                           class="oe_inline"/>
                                                </div>
                                            </group>
                                            <group>
                                                <field name="duration" string="Duration (Months)"/>
                                            </group>
                                        </group>

                                        <separator/>

                                        <!-- == SECTION 3: QUANTITY & PRICING == -->
                                        <group name="pricing_section">
                                            <group string="Quantity &amp; Pricing">
                                                <label for="product_uom_qty"/>
                                                <div class="o_row">
                                                    <field name="product_uom_qty"
                                                           class="oe_inline" force_save="1"/>
                                                    <field name="product_uom"
                                                           groups="uom.group_uom"
                                                           class="oe_inline"
                                                           attrs="{'invisible': [('item_type', '=', 'set')]}"/>
                                                </div>
                                                <field name="price_unit"/>
                                                <field name="discount"
                                                       groups="product.group_discount_per_so_line"/>
                                                <field name="tax_id"
                                                       widget="many2many_tags"
                                                       domain="[('type_tax_use', '=', 'sale'),
                                                                ('company_id', '=', parent.company_id)]"
                                                       options="{'no_create': True}"/>
                                            </group>

                                            <group string="Totals">
                                                <field name="price_subtotal" widget="monetary"/>
                                                <field name="price_tax" widget="monetary"/>
                                                <field name="price_total" widget="monetary"/>
                                            </group>
                                        </group>

                                        <!-- == SECTION 4: STOCK INFO (units only) == -->
                                        <group name="stock_section"
                                               attrs="{'invisible': [('item_type', '=', 'set')]}">
                                            <group string="Inventory">
                                                <field name="stock_status" widget="badge"
                                                       decoration-success="stock_status == 'in_stock'"
                                                       decoration-warning="stock_status == 'low_stock'"
                                                       decoration-danger="stock_status == 'out_of_stock'"
                                                       decoration-info="stock_status == 'no_product'"/>
                                                <field name="warehouse_id" readonly="1"/>
                                            </group>
                                            <group string="Stock Quantities">
                                                <field name="current_stock_qty" string="On Hand"/>
                                                <field name="virtual_stock_qty" string="Forecasted"/>
                                            </group>
                                        </group>

                                        <!-- == SECTION 5: SET COMPONENTS (sets only) == -->
                                        <group name="components_section"
                                               string="Set Components"
                                               attrs="{'invisible': [('item_type', '=', 'unit')]}">
                                            <field name="component_line_ids" nolabel="1"
                                                   colspan="2" readonly="1">
                                                <tree string="Components"
                                                      create="false" delete="false" edit="false">
                                                    <field name="product_id" string="Product"/>
                                                    <field name="name" string="Description"/>
                                                    <field name="lot_id" string="Serial/Lot"/>
                                                    <field name="product_uom_qty" string="Qty"/>
                                                    <field name="product_uom" string="UoM"
                                                           groups="uom.group_uom"/>
                                                    <field name="price_unit"/>
                                                    <field name="price_subtotal" sum="Total"/>
                                                    <field name="state" string="Status"
                                                           widget="badge"
                                                           decoration-success="state == 'ongoing'"
                                                           decoration-muted="state in ('returned','replaced')"
                                                           decoration-info="state == 'draft'"/>
                                                    <field name="currency_id" invisible="1"/>
                                                    <field name="product_uom_category_id" invisible="1"/>
                                                    <button name="action_replace_component"
                                                            type="object"
                                                            string="Replace"
                                                            class="btn-link"
                                                            attrs="{'invisible': ['|',
                                                                ('state', '!=', 'ongoing'),
                                                                ('parent.rental_state', '!=', 'active')]}"/>
                                                </tree>
                                            </field>
                                        </group>

                                        <!-- == SECTION 6: REPLACEMENT HISTORY == -->
                                        <group name="replacement_history_section"
                                               string="Replacement History"
                                               attrs="{'invisible': [('item_type', '=', 'unit')]}">
                                            <field name="replacement_ids" nolabel="1"
                                                   colspan="2" readonly="1">
                                                <tree string="Replacements"
                                                      create="false" delete="false" edit="false">
                                                    <field name="name"/>
                                                    <field name="date"/>
                                                    <field name="product_id"/>
                                                    <field name="old_lot_id" string="Old Serial"/>
                                                    <field name="new_lot_id" string="New Serial"/>
                                                    <field name="reason"/>
                                                    <field name="old_item_destination" string="Destination"/>
                                                    <field name="user_id"/>
                                                    <field name="state" widget="badge"
                                                           decoration-success="state == 'done'"
                                                           decoration-muted="state == 'cancel'"/>
                                                </tree>
                                            </field>
                                        </group>

                                        <!-- Hidden Fields -->
                                        <field name="sequence" invisible="1"/>
                                        <field name="company_id" invisible="1"/>
                                        <field name="currency_id" invisible="1"/>
                                        <field name="state" invisible="1"/>
                                        <field name="product_uom_category_id" invisible="1"/>
                                        <field name="product_type" invisible="1"/>
                                        <field name="duration_unit" invisible="1"/>
                                    </sheet>
                                </form>

                            </field>

                            <!-- ====== TOTALS SECTION ====== -->
                            <group name="note_group" col="6" class="mt-2 mt-md-0">
                                <group colspan="4">
                                </group>
                                <group class="oe_subtotal_footer oe_right"
                                       colspan="2" name="sale_total">
                                    <field name="tax_totals_json"
                                           widget="account-tax-totals-field"
                                           nolabel="1" colspan="2"/>
                                </group>
                            </group>
                        </page>

                        <!-- ====== TAB 2: OTHER INFORMATION ====== -->
                        <page string="Other Information" name="other_info">
                            <group>
                                <group string="Sales">
                                    <label for="pricelist_id"
                                           groups="product.group_product_pricelist"/>
                                    <div groups="product.group_product_pricelist" class="o_row">
                                        <field name="pricelist_id"
                                               attrs="{'readonly': [('state', 'in', ['ongoing', 'hireoff', 'cancel'])]}"
                                               options="{'no_open': True, 'no_create': True}"/>
                                    </div>
                                    <field name="currency_id" invisible="1"/>
                                    <field name="fiscal_position_id"
                                           attrs="{'readonly': [('state', 'in', ['ongoing', 'hireoff', 'cancel'])]}"/>
                                </group>
                                <group string="Reference">
                                    <field name="quotation_id" readonly="1"/>
                                    <field name="company_id"
                                           options="{'no_create': True}"
                                           groups="base.group_multi_company"/>
                                </group>
                            </group>
                        </page>

                        <!-- ====== TAB 3: RENTAL DOCUMENT LOGS ====== -->
                        <page string="Rental Documents" name="documents">
                            <group string="Contract Documents">
                                <field name="rental_contract_ids" nolabel="1" readonly="1"/>
                            </group>
                            <group string="Delivery Order Documents">
                                <field name="rental_picking_ids" nolabel="1" readonly="1"/>
                            </group>
                        </page>

                        <!-- ====== TAB 4: TERMS & CONDITIONS ====== -->
                        <page string="Terms &amp; Conditions" name="terms">
                            <field name="note"
                                   placeholder="Enter terms and conditions here..."
                                   attrs="{'readonly': [('state', 'in', ['cancel'])]}"/>
                        </page>

                    </notebook>
                </sheet>

                <!-- ====== CHATTER ====== -->
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ================================================================== -->
    <!-- GDI RENTAL ORDER: WINDOW ACTION                                    -->
    <!-- ================================================================== -->

    <record id="action_gdi_rental_order" model="ir.actions.act_window">
        <field name="name">Rental Order</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">gdi.rental.order</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new rental order.
            </p>
        </field>
    </record>

</odoo>
