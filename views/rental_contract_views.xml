<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================== -->
    <!-- RENTAL CONTRACT: TREE VIEW                                         -->
    <!-- ================================================================== -->

    <record id="view_gdi_rental_contract_tree_view" model="ir.ui.view">
        <field name="name">view.gdi.rental.contract.tree</field>
        <field name="model">rental.contract</field>
        <field name="arch" type="xml">
            <tree string="Rental Contracts"
                  decoration-muted="state in ['cancel']"
                  decoration-info="state in ['draft']"
                  decoration-danger="state == 'done'"
                  decoration-bf="state == 'signed'">
                <field name="name"/>
                <field name="order_id"/>
                <field name="partner_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <!-- ================================================================== -->
    <!-- RENTAL CONTRACT: FORM VIEW                                         -->
    <!-- ================================================================== -->

    <record id="view_gdi_rental_contract_tree_form" model="ir.ui.view">
        <field name="name">view.gdi.rental.contract.form</field>
        <field name="model">rental.contract</field>
        <field name="arch" type="xml">
            <form string="Rental Contracts" class="o_sale_order">
                <field name="company_id" invisible="1"/>

                <!-- ====== HEADER BUTTONS & STATUSBAR ====== -->
                <header>
                    <button name="create_do" type="object"
                            attrs="{'invisible': [('state', '!=', 'draft')]}"
                            string="Confirm &amp; Create DO" class="oe_highlight"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,signed,cancel"/>
                </header>

                <sheet>
                    <!-- ====== TITLE AREA ====== -->
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <!-- ====== MAIN HEADER: CUSTOMER + ORDER INFO ====== -->
                    <group name="contract_header">
                        <!-- LEFT: Customer Details -->
                        <group name="partner_details">
                            <field name="partner_id"
                                   widget="res_partner_many2one"
                                   attrs="{'readonly': [('state', '!=', 'draft')]}"
                                   context="{'res_partner_search_mode': 'customer',
                                             'show_address': 1, 'show_vat': True}"
                                   options='{"always_reload": True}'/>
                            <field name="user_id" widget="many2one_avatar_user"
                                   attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                        </group>

                        <!-- RIGHT: Order Details -->
                        <group name="order_details">
                            <field name="order_id"
                                   attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="create_date" string="Created Date"/>
                            <field name="customer_reference" string="Customer Ref."
                                   attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="customer_po_number"
                                   attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                        </group>
                    </group>

                    <!-- ====== RENTAL SCHEDULE SECTION ====== -->
                    <group name="rental_schedule" string="Rental Schedule">
                        <group string="Period">
                            <label for="start_date" string="Rental Period"/>
                            <div class="o_row">
                                <field name="start_date" class="oe_inline"
                                       attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                                <i class="fa fa-long-arrow-right mx-2"
                                   aria-label="Arrow" title="Arrow"/>
                                <field name="end_date" class="oe_inline"
                                       attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            </div>
                            <field name="rental_duration" string="Duration (Months)"
                                   readonly="1"/>
                        </group>
                        <group string="Reference">
                            <field name="pricelist_id" invisible="1"/>
                            <field name="duration" invisible="1"/>
                            <field name="duration_unit" invisible="1"/>
                        </group>
                    </group>

                    <!-- ====== MAIN NOTEBOOK ====== -->
                    <notebook>

                        <!-- ====== TAB 1: RENTAL ITEMS ====== -->
                        <page string="Rental Items" name="rental_items">
                            <field name="contract_line_ids"
                                   context="{'default_contract_id': id}"
                                   attrs="{'readonly': [('state', '!=', 'draft')]}">

                                <!-- LINE TREE (non-editable: click to open popup) -->
                                <tree string="Contract Lines">
                                    <field name="sequence" widget="handle"/>
                                    <field name="item_type" string="Type"/>
                                    <field name="item_code"/>
                                    <field name="name" string="Description"/>
                                    <field name="duration_string" string="Duration"/>
                                    <field name="start_date" string="From" optional="show"/>
                                    <field name="end_date" string="To" optional="show"/>
                                    <field name="product_uom_qty" string="Qty" force_save="1"/>
                                    <field name="product_uom" string="UoM"
                                           groups="uom.group_uom" optional="show"
                                           invisible="1"/>
                                    <field name="product_uom_txt" string="UoM"/>
                                    <field name="price_unit"/>
                                    <field name="price_subtotal" widget="monetary"/>
                                    <field name="currency_id" invisible="1"/>
                                    <field name="company_id" invisible="1"/>
                                </tree>

                                <!-- LINE POPUP FORM -->
                                <form string="Contract Line Detail">
                                    <sheet>
                                        <!-- == SECTION 1: ITEM DEFINITION == -->
                                        <group name="item_definition">
                                            <group string="Item Type">
                                                <field name="item_type"
                                                       widget="radio"
                                                       options="{'horizontal': true}"/>
                                                <field name="product_id"
                                                       attrs="{'required': [('item_type', '=', 'unit')],
                                                               'invisible': [('item_type', '=', 'set')]}"
                                                       domain="[('rent_ok', '=', True),
                                                                '|', ('company_id', '=', False),
                                                                ('company_id', '=', parent.company_id)]"
                                                       context="{'partner_id': parent.partner_id}"
                                                       force_save="1"
                                                       options="{'no_create': True, 'no_open': True}"/>
                                                <field name="item_code"/>
                                            </group>
                                            <group string="Description">
                                                <field name="name" nolabel="1"
                                                       placeholder="Product description..."
                                                       required="1" colspan="2"/>
                                            </group>
                                        </group>

                                        <separator/>

                                        <!-- == SECTION 2: RENTAL PERIOD == -->
                                        <group name="period_section" string="Rental Period">
                                            <group>
                                                <label for="start_date" string="Rental Period"/>
                                                <div class="o_row">
                                                    <field name="start_date" class="oe_inline"/>
                                                    <i class="fa fa-long-arrow-right mx-2"
                                                       aria-label="Arrow" title="Arrow"/>
                                                    <field name="end_date" class="oe_inline"/>
                                                </div>
                                            </group>
                                            <group>
                                                <field name="duration" string="Duration (Months)"
                                                       readonly="1"/>
                                                <field name="duration_unit" invisible="1"/>
                                            </group>
                                        </group>

                                        <separator/>

                                        <!-- == SECTION 3: QUANTITY & PRICING == -->
                                        <group name="pricing_section">
                                            <group string="Quantity &amp; Pricing">
                                                <label for="product_uom_qty"/>
                                                <div class="o_row">
                                                    <field name="product_uom_qty"
                                                           class="oe_inline" force_save="1"/>
                                                    <field name="product_uom"
                                                           groups="uom.group_uom"
                                                           class="oe_inline" force_save="1"
                                                           attrs="{'invisible': [('item_type', '=', 'set')]}"/>
                                                    <field name="product_uom_txt"
                                                           attrs="{'invisible': [('item_type', '!=', 'set')]}"/>
                                                </div>
                                                <field name="price_unit"/>
                                                <field name="discount"
                                                       groups="product.group_discount_per_so_line"/>
                                                <field name="tax_id"
                                                       widget="many2many_tags"
                                                       domain="[('type_tax_use','=','sale'),
                                                                ('company_id','=',parent.company_id)]"
                                                       options="{'no_create': True}"/>
                                            </group>
                                            <group string="Totals">
                                                <field name="price_subtotal" widget="monetary"/>
                                                <field name="price_tax" widget="monetary"/>
                                                <field name="price_total" widget="monetary"/>
                                            </group>
                                        </group>

                                        <!-- == SECTION 4: STOCK INFO (units only) == -->
                                        <group name="stock_section"
                                               attrs="{'invisible': [('item_type', '=', 'set')]}">
                                            <group string="Inventory">
                                                <field name="stock_status" widget="badge"
                                                       decoration-success="stock_status == 'in_stock'"
                                                       decoration-warning="stock_status == 'low_stock'"
                                                       decoration-danger="stock_status == 'out_of_stock'"
                                                       decoration-info="stock_status == 'no_product'"/>
                                                <field name="warehouse_id" readonly="1"/>
                                            </group>
                                            <group string="Stock Quantities">
                                                <field name="current_stock_qty" string="On Hand"/>
                                                <field name="virtual_stock_qty" string="Forecasted"/>
                                            </group>
                                        </group>

                                        <!-- == SECTION 5: COMPONENTS (sets only) == -->
                                        <group name="components_section"
                                               attrs="{'invisible': [('item_type', '=', 'unit')]}">
                                            <field name="component_line_ids" nolabel="1" colspan="2"
                                                   attrs="{'required': [('item_type', '=', 'set')]}">
                                                <tree>
                                                    <field name="product_id"/>
                                                    <field name="name"/>
                                                    <field name="product_uom_qty" string="Qty"/>
                                                    <field name="product_uom" string="UoM"
                                                           groups="uom.group_uom"/>
                                                    <field name="price_unit"/>
                                                    <field name="price_subtotal" sum="Total Cost"/>
                                                    <field name="product_uom_category_id" invisible="1"/>
                                                </tree>
                                            </field>
                                        </group>

                                        <!-- Hidden Fields -->
                                        <field name="sequence" invisible="1"/>
                                        <field name="company_id" invisible="1"/>
                                        <field name="currency_id" invisible="1"/>
                                        <field name="product_uom_category_id" invisible="1"/>
                                        <field name="product_type" invisible="1"/>
                                    </sheet>
                                </form>

                            </field>
                        </page>

                    </notebook>
                </sheet>

                <!-- ====== CHATTER ====== -->
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ================================================================== -->
    <!-- RENTAL CONTRACT: WINDOW ACTION                                     -->
    <!-- ================================================================== -->

    <record id="action_gdi_rental_contracts_view" model="ir.actions.act_window">
        <field name="name">Rental Contract</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">rental.contract</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new rental contract.
            </p>
        </field>
    </record>

</odoo>
