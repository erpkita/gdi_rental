<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================== -->
    <!-- GDI RENTAL SET: TREE VIEW                                          -->
    <!-- ================================================================== -->

    <record id="view_gdi_rental_set_tree" model="ir.ui.view">
        <field name="name">gdi.rental.set.tree</field>
        <field name="model">gdi.rental.set</field>
        <field name="arch" type="xml">
            <tree string="Rental Sets">
                <field name="code"/>
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <!-- ================================================================== -->
    <!-- GDI RENTAL SET: FORM VIEW                                          -->
    <!-- ================================================================== -->

    <record id="view_gdi_rental_set_form" model="ir.ui.view">
        <field name="name">gdi.rental.set.form</field>
        <field name="model">gdi.rental.set</field>
        <field name="arch" type="xml">
            <form string="Rental Set">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name"/></h1>
                        <label for="code" class="oe_edit_only"/>
                        <h2><field name="code"/></h2>
                    </div>
                    <group>
                        <field name="active" invisible="1"/>
                    </group>
                    <notebook>
                        <page string="Components">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="product_id" domain="[('rent_ok', '=', True)]"/>
                                    <field name="quantity"/>
                                    <field name="qty_available" string="On Hand"/>
                                    <field name="virtual_available" string="Forecasted"/>
                                    <field name="stock_status" string="Status"
                                           widget="badge"
                                           decoration-success="stock_status == 'in_stock'"
                                           decoration-warning="stock_status == 'low_stock'"
                                           decoration-danger="stock_status == 'out_of_stock'"
                                           decoration-info="stock_status == 'no_product'"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Description">
                            <group>
                                <field name="description" nolabel="1" placeholder="Add a description for this set..."/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ================================================================== -->
    <!-- GDI RENTAL SET: ACTION                                             -->
    <!-- ================================================================== -->

    <record id="action_gdi_rental_set" model="ir.actions.act_window">
        <field name="name">Rental Sets</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">gdi.rental.set</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
